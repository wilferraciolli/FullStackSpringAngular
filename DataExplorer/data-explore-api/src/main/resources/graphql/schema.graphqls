type Query {
    people(filter: PersonFilter, sort: PersonSort, page: PageInput): PersonPage
    addresses(filter: AddressFilter, sort: AddressSort, page: PageInput): AddressPage
}

# ── Pagination ──────────────────────────────────────────────────────────────
input PageInput {
    page: Int   # 0-based page index (default 0)
    size: Int   # rows per page (default 20)
}

type PersonPage {
    content:       [Person]
    totalElements: Int
    totalPages:    Int
    page:          Int
    size:          Int
}

type AddressPage {
    content:       [Address]
    totalElements: Int
    totalPages:    Int
    page:          Int
    size:          Int
}

# ── Entities ──────────────────────────────────
type Person {
    id: ID
    email: String
    firstName: String
    lastName: String
    phoneNumber: String
    bio: String
    jobTitle: String
    startDate: String
    effectiveDate: String
}

type Address {
    id: ID
    city: String
    street: String
    effectiveDate: String
}

# ── Entity sorts ──────────────────────────────────
enum SortOrder {
    ASC
    DESC
}

input PersonSort {
    field: PersonSortField
    order: SortOrder
}

enum PersonSortField {
    lastName
    firstName
    email
    jobtitle
    startDate
}

input AddressSort {
    field: AddressSortField
    order: SortOrder
}

enum AddressSortField {
    street
    city
}

# ── Entity filters ──────────────────────────────────
input AddressFilter {
    city: StringFilter
    street: StringFilter
    effectiveDate: DateFilter
}

input PersonFilter {
    id: StringFilter
    firstName: StringFilter
    lastName: StringFilter
    email: StringFilter
    jobTitle: StringFilter
    startDate: DateFilter
    effectiveDate: DateFilter
}

# ── Reusable filter inputs ──────────────────────────────────
input StringFilter {
  equals:     String
  notEquals:  String
  contains:   String
  startsWith: String
  isNull:     Boolean
}

input DateFilter {
  equals:      String   # ISO-8601 e.g. "2024-01-01"
  before:      String
  after:       String
  isNull:      Boolean
}
