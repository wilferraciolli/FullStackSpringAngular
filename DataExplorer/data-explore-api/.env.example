# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your real keys.
# Groq API key (free tier at https://console.groq.com → API Keys → Create Key)
# Used as fallback when Chrome AI is unavailable.
GROQ_API_KEY=your_groq_api_key_here
# Set to true if you get PKIX / certificate_unknown errors (corporate SSL-inspecting firewall)
AI_GROQ_TRUST_ALL_CERTS=false
